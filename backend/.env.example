# 参照用です。このApplicationは.envを自動では読み込みません。
# README.mdの手順どおり、PowerShellの環境変数として設定してください。

DIALOGUE_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
DIALOGUE_TIMEOUT_SECONDS=30
DIALOGUE_MAX_OUTPUT_TOKENS=240

# VOICEVOX Engineの既定ローカルAPI。話者IDは使用するEngineの/api/docsまたは/speakersで確認します。
VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=14
VOICEVOX_TIMEOUT_SECONDS=30

# Local speech recognition. The model is downloaded once on first preparation.
TRANSCRIPTION_MODEL=small
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
