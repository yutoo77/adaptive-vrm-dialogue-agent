root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,json,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.{py,toml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{ps1,cmd}]
end_of_line = crlf
